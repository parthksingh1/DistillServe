# ---------------------------------------------------------------------------
# DistillServe web console — environment template
#
#   cp apps/web/.env.example apps/web/.env.local
#
# Only VITE_-prefixed variables reach the browser bundle. Nothing secret goes
# in this file: anything here is readable by every visitor.
# ---------------------------------------------------------------------------

# Base URL of the gateway. Leave as-is for `make dev`; point at the Render URL
# for a Vercel preview or production deploy.
VITE_GATEWAY_URL=http://localhost:8000

# Fallback label for the nav mode indicator, used only for the first paint
# before GET /healthz resolves. The backend is always authoritative.
VITE_DEFAULT_MODE=hosted

# Optional: Langfuse project URL, used to deep-link a trace from the Traces
# page to its Langfuse detail view.
VITE_LANGFUSE_PROJECT_URL=
