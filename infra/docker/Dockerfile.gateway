# syntax=docker/dockerfile:1.7
#
# Two stages so the runtime image carries no build toolchain and no uv cache.
# The dependency layer is keyed on the lockfile alone, so editing source code
# does not invalidate it.
FROM python:3.11-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5.4 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY apps/gateway/pyproject.toml apps/gateway/
COPY packages/schemas/pyproject.toml packages/schemas/
COPY packages/otel/pyproject.toml packages/otel/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --all-packages --frozen --no-dev --no-install-workspace

COPY apps/gateway apps/gateway
COPY packages packages

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --all-packages --frozen --no-dev

FROM python:3.11-slim AS runtime

# Non-root: the gateway needs no privileged capability.
RUN useradd --create-home --uid 10001 distillserve

WORKDIR /app
COPY --from=builder --chown=distillserve:distillserve /app /app
COPY --chown=distillserve:distillserve data/reference data/reference

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DISTILLSERVE_HOST=0.0.0.0 \
    PORT=8000

USER distillserve
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz').status==200 else 1)"

CMD ["uvicorn", "distillserve_gateway.main:app", "--host", "0.0.0.0", "--port", "8000"]
