# ---------------------------------------------------------------------------
# DistillServe — root environment template
#
#   cp .env.example .env
#
# Everything the gateway reads is listed here. Copy, fill in, never commit the
# result: `.env` is git-ignored.
# ---------------------------------------------------------------------------

# === Deployment mode =======================================================
# hosted      Route to hosted providers via LiteLLM. Needs only a provider key.
# self_hosted Route to a vLLM OpenAI-compatible endpoint on your GPU cluster.
#             Requires VLLM_ENDPOINT and the manifests in infra/k8s/.
# sandbox     Generation runs through the hosted backend while `self_hosted`
#             telemetry streams from the reference benchmark dataset in
#             data/reference/. Use this to evaluate dashboards, rollout
#             controls and eval reports without provisioning GPUs.
DISTILLSERVE_MODE=hosted

# local | preview | production | test
DISTILLSERVE_ENV=local

# === Providers (hosted + sandbox generation path) ==========================
# At least one key is required unless DISTILLSERVE_MODE=self_hosted.
# Any one of these is enough: the teacher/student pair below is derived from
# whichever provider you configure.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Routing targets. Leave blank to derive them from the configured provider:
#   groq       groq/llama-3.3-70b-versatile   -> groq/llama-3.1-8b-instant
#   gemini     gemini/gemini-2.5-pro          -> gemini/gemini-2.5-flash-lite
#   openai     openai/gpt-4o                  -> openai/gpt-4o-mini
#   anthropic  anthropic/claude-sonnet-4-5    -> anthropic/claude-haiku-4-5
# Set them explicitly to override. Any LiteLLM-addressable id works.
DISTILLSERVE_TEACHER_MODEL=
DISTILLSERVE_STUDENT_MODEL=

# === Self-hosted serving ===================================================
# Base URL of the vLLM OpenAI-compatible server. Required when
# DISTILLSERVE_MODE=self_hosted; optional otherwise (setting it makes the
# self-hosted code path reachable for smoke-testing from any mode).
VLLM_ENDPOINT=

# === Access control ========================================================
# Off locally so `make dev` needs no token; turn it on for any deployment that
# is reachable from the internet.
DISTILLSERVE_AUTH_REQUIRED=false

# Optional YAML file of tenants with SHA-256 token digests.
#   uv run python -c "import hashlib,sys;print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" MY-TOKEN
DISTILLSERVE_TENANTS_FILE=

# Demo access. The built-in `demo` tenant is enabled by default with the
# published token below, so a fresh deployment is demonstrable with no setup:
# hand someone the console URL and this token.
#
# It is not a secret, and does not need to be. The demo tenant holds `read`
# and `infer` only — it can drive the Playground and every dashboard, and
# cannot advance a rollout, hot-swap an adapter or promote a model. It is
# also rate-capped and carries a $5 monthly budget.
#
# Override it for private demo access. Set it empty to disable the tenant.
DISTILLSERVE_DEMO_TOKEN=distillserve-demo
# Rate cap for the demo tenant, so a shared link cannot exhaust your quota.
DISTILLSERVE_DEMO_RPM=20

# === Infrastructure ========================================================
# Semantic cache + per-tenant token buckets. Upstash works as-is.
REDIS_URL=redis://localhost:6379/0

# === Observability =========================================================
# OTel GenAI spans are exported to Langfuse over OTLP/HTTP. Both keys must be
# set for export to be enabled; without them the gateway traces locally and
# exports nothing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_SAMPLE_RATIO=1.0

# === Gateway HTTP ==========================================================
PORT=8000
DISTILLSERVE_HOST=0.0.0.0
DISTILLSERVE_CORS_ALLOW_ORIGINS=http://localhost:5173
DISTILLSERVE_LOG_LEVEL=info
# false gives colourised console logs, which is what you want locally.
DISTILLSERVE_LOG_JSON=false

# === Reference dataset (sandbox telemetry source) ==========================
DISTILLSERVE_REFERENCE_DATA_DIR=data/reference
# Seed + wall clock produce reproducible live telemetry, so the dashboard
# tells the same story on every visit.
DISTILLSERVE_REFERENCE_SEED=20250901
